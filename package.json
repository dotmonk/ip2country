{
    "name": "@dotmonk/ip2country",
    "version": "1.0.408",
    "description": "Self-contained IP to country lookup with zero runtime dependencies",
    "main": "index.js",
    "types": "index.d.ts",
    "files": [
        "index.js",
        "index.d.ts",
        "data.json.gz"
    ],
    "scripts": {
        "update": "tsx update.ts",
        "test": "tsx test.ts",
        "build": "tsc index.ts --declaration",
        "pages:sync-janus": "sh docs/sync-janus.sh",
        "pages:build": "tsx scripts/chunk-for-pages.ts",
        "pages": "npm run pages:sync-janus && npm run pages:build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dotmonk/ip2country.git"
    },
    "author": "Magnus Weinberg <magnus.weinberg@gmail.com>",
    "license": "Public Domain",
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@types/node": "^20.19.16",
        "tsx": "^4.20.5",
        "typescript": "^5.0.4"
    }
}
